R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=certificate-bucket-1
R2_PREFIX=nginx
AWS_ACCESS_KEY_ID=<r2-access-key-id>
AWS_SECRET_ACCESS_KEY=<r2-secret-access-key>

SYNC_ROOT=/var/lib/nginx-sync
ETC_NGINX=/etc/nginx
MODE=full
PARTIAL_PATHS=sites-enabled,snippets,certs,streams-enabled
KEEP_BACKUPS=10
SYNC_INTERVAL=30s
